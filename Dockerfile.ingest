FROM rust:1.87-bookworm AS builder
WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY examples ./examples

RUN cargo build --release --bin sandtrace-ingest

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system sandtrace \
    && useradd --system --gid sandtrace --create-home --home-dir /var/lib/sandtrace sandtrace

WORKDIR /app
COPY --from=builder /app/target/release/sandtrace-ingest /usr/local/bin/sandtrace-ingest
COPY --from=builder /app/examples /app/examples

RUN mkdir -p /var/lib/sandtrace-ingest && chown -R sandtrace:sandtrace /var/lib/sandtrace-ingest /app

USER sandtrace

ENV SANDTRACE_INGEST_BIND=0.0.0.0:8080
ENV SANDTRACE_INGEST_DIR=/var/lib/sandtrace-ingest

EXPOSE 8080

CMD ["sandtrace-ingest"]
